*.aux
*.log
*.out
*.toc
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.fdb_latexmk
*.fls
mainNotes.bib

# Windows artifacts
nul
Thumbs.db
Desktop.ini

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Secrets
*.env
.env.*
credentials.json

