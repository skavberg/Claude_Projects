.claude/debug/
.claude/cache/
.claude/file-history/
.claude/history.jsonl
.claude/paste-cache/
.claude/projects/
.claude/shell-snapshots/
.claude/stats-cache.json
.claude/todos/
.claude/downloads/
.claude/plans/
.claude/plugins/

# Team runtime data (inboxes, locks are session-specific)
.claude/teams/*/inboxes/
.claude/tasks/*/.lock

# Claude_Setup is its own repo
Claude_Setup/

